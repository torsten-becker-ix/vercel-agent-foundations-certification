# Copy to .env.local, or run `vercel env pull .env.local` after `vercel link`.
# Never commit real values. Secrets never use the NEXT_PUBLIC_ prefix.

# Base URL of the Vercel Swag Store API.
API_BASE_URL=https://vercel-agentic-swag-store-api.vercel.app/api

# Protection-bypass secret for the store API, sent as `x-vercel-protection-bypass`.
# The value is prefilled by the assignment's Deploy link.
BYPASS_SECRET=

# Vercel AI Gateway auth. Locally, `vercel env pull` writes a VERCEL_OIDC_TOKEN
# (expires after 12 h — pull again). Alternatively set an AI Gateway API key:
# Locally, put AI_GATEWAY_API_KEY in .env.development.local (vercel env pull overwrites .env.local).
# AI_GATEWAY_API_KEY=

# HMAC secret for signed tool approvals (return confirmations). >= 32 random bytes,
# e.g. `openssl rand -base64 48`. Server-only; set as Sensitive on Vercel.
TOOL_APPROVAL_SECRET=

# Optional: public site URL for metadata, robots and sitemap (not a secret, so the
# NEXT_PUBLIC_ prefix is fine). Defaults to Vercel's production domain, else localhost.
# NEXT_PUBLIC_SITE_URL=
